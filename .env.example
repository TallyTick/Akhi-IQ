PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://akhi_user:akhi_password@localhost:5432/akhi_db
# Required outside LOCAL_MODE; set this to the Redis service URL.
REDIS_URL=
WHATSAPP_WEBHOOK_SECRET=whsec_test_whatsapp_secret_key_12345
# Allowed values: mock, twilio, or meta.
WHATSAPP_PROVIDER=mock
# Meta WhatsApp Cloud API; required only when WHATSAPP_PROVIDER=meta.
META_VERIFY_TOKEN=replace-with-a-meta-webhook-verification-token
META_APP_SECRET=replace-with-your-meta-app-secret
META_ACCESS_TOKEN=replace-with-your-meta-access-token
META_PHONE_NUMBER_ID=replace-with-your-meta-phone-number-id
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_WHATSAPP_FROM=+15551234567
PUBLIC_BASE_URL=https://your-public-host.example.com
INTERNAL_API_SECRET=replace-with-a-random-secret-at-least-32-characters
SHOPIFY_MODE=mock
SHOPIFY_APP_URL=https://your-shopify-app.example.com
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
# 32-byte (256-bit) encryption key as 64 hex characters or 32-char string:
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LOG_LEVEL=info
