{
  "name": "akhi-iq",
  "version": "1.0.0",
  "description": "WhatsApp order-status support backend for Shopify",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:api": "tsx src/api/server.ts",
    "start:worker": "tsx src/worker/index.ts",
    "dev:local": "cross-env LOCAL_MODE=true tsx src/index.ts",
    "seed": "tsx scripts/seed.ts",
    "simulate": "tsx scripts/simulate-inbound.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "keywords": [
    "whatsapp",
    "shopify",
    "fastify",
    "bullmq",
    "drizzle"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bullmq": "^6.3.14",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-raw-body": "^6.0.2",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
